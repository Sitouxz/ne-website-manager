!.env.example

# graphify knowledge-graph output (generated, ~4MB)
graphify-out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# superpowers scratch (subagent-driven-development progress ledger)
.superpowers/

# worktrees
.worktrees/
