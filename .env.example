# NE Website Manager — environment variables
#
# Copy to `.env.local` for local development, and set the same keys on the
# Vercel deployment. Values here are placeholders only — never commit real
# secrets to this file.

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security — never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cron (required in production) ────────────────────────────────────────────
# Shared secret Vercel Cron sends as `Authorization: Bearer ${CRON_SECRET}`.
# Both cron routes fail closed with 401 when this is unset, which means:
#   - scheduled posts never publish, and
#   - `analytics_daily` never fills, so the dashboard sparkline and the
#     30/90-day analytics views stay empty.
# Neither failure is visible in the UI, so check this first if either breaks.
# See vercel.json for the schedules.
CRON_SECRET=generate-a-long-random-string

# ── Metricool (optional) ─────────────────────────────────────────────────────
# Powers the Social screen. Without both values that screen shows a
# "not connected" state and everything else works normally.
METRICOOL_USER_ID=
METRICOOL_USER_TOKEN=

# ── Notes ────────────────────────────────────────────────────────────────────
# CMS_PREVIEW_SECRET and CMS_REVALIDATE_SECRET are NOT set here. They belong
# to each CLIENT site (the separate repos that consume the generated SDK), and
# should match that client's `revalidate_secret` in Settings -> Publishing.
#
# SEED_REVALIDATE_SECRET is read by scripts/seed-client.mjs only, and is passed
# as an env var at run time rather than stored in a file — see that script's
# header for usage.
